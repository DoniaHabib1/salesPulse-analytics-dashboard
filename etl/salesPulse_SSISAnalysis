-- 13. Categories with Revenue, Profit & Quantity (الفئات مع الكميات)
---------------------------------------------------------------------
SELECT
    p.Category,
    SUM(f.Sales) AS Total_Sales,
    SUM(f.Profit) AS Total_Profit,
    SUM(f.Quantity) AS Total_Quantity
FROM FactSales f
JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
GROUP BY
    p.Category
ORDER BY
    Total_Sales DESC;

---------------------------------------------------------------------
-- 14. Category Profitability with Cost & Rounded Margin (الربحية مع التكلفة وهامش دقيق)
---------------------------------------------------------------------
SELECT
    p.Category,
    SUM(f.Sales) AS Total_Sales,
    SUM(f.Cost) AS Total_Cost,
    SUM(f.Profit) AS Total_Profit,
    ROUND(
        SUM(f.Profit) * 100.0 / NULLIF(SUM(f.Sales), 0),
        2
    ) AS Profit_Margin
FROM FactSales f
JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
GROUP BY
    p.Category
ORDER BY
    Total_Profit DESC;

