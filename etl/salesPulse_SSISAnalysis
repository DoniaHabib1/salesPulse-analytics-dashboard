/* =========================================================
   PHASE 1 — DATA EXPLORATION
   ========================================================= */


/* 1. Count Rows */

SELECT COUNT(*) AS Total_Rows
FROM FactSales;


/* 2. Preview Data */

SELECT TOP 10 *
FROM FactSales;


/* 3. Check Duplicate Order IDs */

SELECT
    Order_ID,
    COUNT(*) AS Number_Of_Lines
FROM FactSales
GROUP BY Order_ID
HAVING COUNT(*) > 1;


/* 4. Check Referential Integrity — Product */

SELECT COUNT(*) AS Invalid_Product_IDs
FROM FactSales f
LEFT JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
WHERE p.Product_ID IS NULL;


/* 5. Check Referential Integrity — Orders */

SELECT COUNT(*) AS Invalid_Order_IDs
FROM FactSales f
LEFT JOIN DimOrder o
    ON f.Order_ID = o.Order_ID
WHERE o.Order_ID IS NULL;


/* =========================================================
   PHASE 2 — BUSINESS KPIs
   ========================================================= */


/* 6. Total Revenue */

SELECT
    SUM(Sales) AS Total_Revenue
FROM FactSales;


/* 7. Total Profit */

SELECT
    SUM(Profit) AS Total_Profit
FROM FactSales;


/* 8. Total Orders */

SELECT
    COUNT(DISTINCT Order_ID) AS Total_Orders
FROM FactSales;


/* 9. Total Quantity */

SELECT
    SUM(Quantity) AS Total_Quantity
FROM FactSales;


/* 10. Average Order Value */

SELECT
    SUM(Sales) / NULLIF(COUNT(DISTINCT Order_ID), 0)
        AS Average_Order_Value
FROM FactSales;


/* 11. Profit Margin */

SELECT
    SUM(Profit) / NULLIF(SUM(Sales), 0) * 100
        AS Profit_Margin
FROM FactSales;


/* =========================================================
   PHASE 3 — MONTHLY SALES TREND
   ========================================================= */


/* 12. Monthly Sales Trend */

SELECT
    d.Year,
    d.Month_Number,
    d.Month_Name,
    SUM(f.Sales) AS Monthly_Sales
FROM FactSales f
JOIN DimOrder o
    ON f.Order_ID = o.Order_ID
JOIN DimDate d
    ON o.Order_Date = d.Date
GROUP BY
    d.Year,
    d.Month_Number,
    d.Month_Name
ORDER BY
    d.Year,
    d.Month_Number;


/* =========================================================
   PHASE 4 — BUSINESS QUESTIONS
   ========================================================= */


/* 13. Sales by Category */

SELECT
    p.Category,
    SUM(f.Sales) AS Total_Sales
FROM FactSales f
JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
GROUP BY
    p.Category
ORDER BY
    Total_Sales DESC;


/* 14. Sales by Product */

SELECT
    p.Product_Name,
    SUM(f.Sales) AS Total_Sales
FROM FactSales f
JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
GROUP BY
    p.Product_Name
ORDER BY
    Total_Sales DESC;


/* 15. Sales by Customer */

SELECT
    c.Customer_Name,
    SUM(f.Sales) AS Total_Sales
FROM FactSales f
JOIN DimOrder o
    ON f.Order_ID = o.Order_ID
JOIN DimCustomer c
    ON o.Customer_ID = c.Customer_ID
GROUP BY
    c.Customer_Name
ORDER BY
    Total_Sales DESC;


/* 16. Sales by Geography */

SELECT
    g.Country,
    SUM(f.Sales) AS Total_Sales
FROM FactSales f
JOIN DimOrder o
    ON f.Order_ID = o.Order_ID
JOIN DimGeography g
    ON o.Geography_ID = g.Geography_ID
GROUP BY
    g.Country
ORDER BY
    Total_Sales DESC;


/* 17. Top 10 Products */

SELECT TOP 10
    p.Product_Name,
    SUM(f.Sales) AS Total_Sales
FROM FactSales f
JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
GROUP BY
    p.Product_Name
ORDER BY
    Total_Sales DESC;


/* 18. Top 10 Customers */

SELECT TOP 10
    c.Customer_Name,
    SUM(f.Sales) AS Total_Sales
FROM FactSales f
JOIN DimOrder o
    ON f.Order_ID = o.Order_ID
JOIN DimCustomer c
    ON o.Customer_ID = c.Customer_ID
GROUP BY
    c.Customer_Name
ORDER BY
    Total_Sales DESC;


/* 19. Profit by Category */

SELECT
    p.Category,
    SUM(f.Profit) AS Total_Profit
FROM FactSales f
JOIN DimProduct p
    ON f.Product_ID = p.Product_ID
GROUP BY
    p.Category
ORDER BY
    Total_Profit DESC;


/* =========================================================
   PHASE 5 — YEAR OVER YEAR GROWTH
   ========================================================= */


/* 20. Year-over-Year Sales Growth */

WITH YearlySales AS
(
    SELECT
        d.Year,
        SUM(f.Sales) AS Total_Sales
    FROM FactSales f
    JOIN DimOrder o
        ON f.Order_ID = o.Order_ID
    JOIN DimDate d
        ON o.Order_Date = d.Date
    GROUP BY
        d.Year
)

SELECT
    Year,
    Total_Sales,

    LAG(Total_Sales) OVER (
        ORDER BY Year
    ) AS Previous_Year_Sales,

    (
        (Total_Sales -
         LAG(Total_Sales) OVER (ORDER BY Year))
        /
        NULLIF(
            LAG(Total_Sales) OVER (ORDER BY Year),
            0
        )
    ) * 100 AS YoY_Growth

FROM YearlySales
ORDER BY
    Year;


